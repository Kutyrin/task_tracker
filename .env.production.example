GHCR_IMAGE_NAMESPACE=ghcr.io/your-github-username/task-tracker
IMAGE_TAG=latest

POSTGRES_USER=task_tracker
POSTGRES_PASSWORD=replace_with_alphanumeric_password
POSTGRES_DB=task_tracker

JWT_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret

CORS_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Password reset email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=2465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM="Task Tracker <no-reply@example.com>"
FRONTEND_URL=https://app.example.com